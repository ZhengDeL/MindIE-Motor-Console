# Publish platform sources, reviewed release design, and the pinned upstream.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.gitmodules
!/AGENTS.md
!/CONTRIBUTING.md
!/README.md
!/LICENSE
!/NOTICE.md
!/SECURITY.md
!/.github/
/.github/*
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/plugin-proposal.yml
!/web/
!/mindie-motor/
/mindie-motor/*
!/mindie-motor/upstream/

**/.pytest_cache/
**/__pycache__/
**/*.pyc
**/*.tsbuildinfo
**/.venv*/
**/node_modules/
**/dist/
**/.data/
**/.hx-data/
**/.env
**/.env.*
!**/.env.example
/web/screenshots/
/web/ANALYSIS/
/web/frontend/public/fonts/
/web/frontend/public/brand/
/web/frontend/*-review.png
/web/部署接入手册.md
/web/validation/pytest.log
/web/validation/results.json

# Tests and acceptance evidence stay local, per repository owner.
/web/tests/
/web/pytest.ini
/web/validation/
/web/VALIDATION.md
/web/frontend/ui_*.py
/web/frontend/artifacts/
/web/frontend/.ui-test-work/
/web/.ui-test-work/
**/test-results/
**/playwright-report/
