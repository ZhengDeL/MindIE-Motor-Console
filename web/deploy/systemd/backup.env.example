# Paths only. Configure a real remote filesystem before enabling the timer.
# Adapt the matching service RequiresMountsFor/ConditionPathIsMountPoint and
# ReadWritePaths whenever these deployment paths differ.
MOTOR_BACKUP_PROJECT_DIR=/opt/motor-console-project
MOTOR_BACKUP_DATA_DIR=/var/lib/motor-console
MOTOR_BACKUP_DESTINATION=/mnt/motor-console-backups/console
MOTOR_BACKUP_MOUNT=/mnt/motor-console-backups
MOTOR_BACKUP_KEY_FILE=/etc/motor-console/backup.key
