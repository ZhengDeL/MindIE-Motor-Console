# Reference only. prepare_agent.py generates a private new credential ring.
MOTOR_CONSOLE_IMAGE=registry.example.test/motor-console@sha256:REPLACE_WITH_REVIEWED_DIGEST
MOTOR_AGENT_DATA_DIR=/opt/motor-console/agents/docker-local/data
# Optional startup-only selection under the existing read-only profiles mount.
MOTOR_AGENT_PROVIDER_ASSEMBLY_FILE=
MOTOR_AGENT_CREDENTIALS_HOST_PATH=/opt/motor-console/agents/docker-local/data/credentials
MOTOR_AGENT_CREDENTIALS_CONTAINER_PATH=/run/motor-agent-credentials
MOTOR_AGENT_TOKEN_FILE=/run/motor-agent-credentials/agent-token.json
MOTOR_HOST_WORKSPACE_DIR=/opt/motor-console/workspace/docker-local
MOTOR_AGENT_BIND_IP=127.0.0.1
MOTOR_AGENT_PORT=19082
MOTOR_AGENT_CPUS=1
MOTOR_AGENT_MEMORY_LIMIT=1g
MOTOR_AGENT_PIDS_LIMIT=256
MOTOR_AGENT_NATIVE_CONCURRENCY=1
MOTOR_NPU_ADMISSION_MODE=observed
MOTOR_NPU_SNAPSHOT_FILE=/host/opt/motor-console/npu/observation.json
MOTOR_RESOURCE_CACHE_SECONDS=10
MOTOR_RESOURCE_TTL_SECONDS=45
# Direct HTTPS: configure_agent_tls.py writes server certificate variables only
# after generating new private material. Set a real management bind IP then.
