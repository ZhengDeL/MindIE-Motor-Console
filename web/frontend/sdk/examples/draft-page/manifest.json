{
  "schemaVersion": 1,
  "id": "example.drafts",
  "name": "独立草稿工作台",
  "description": "独立完整页面和自有格式化契约；读取并保存控制面草稿。",
  "version": "1.0.0",
  "sdkVersion": "1.0.0",
  "entrypoint": "entry.mjs",
  "provides": [
    { "slot": "example.drafts.page", "version": "1.0.0", "kind": "component" },
    { "slot": "example.drafts.formatter", "version": "2.3.0", "kind": "service", "methods": ["format"] }
  ],
  "requires": [{ "slot": "example.drafts.formatter", "range": "^2.0.0" }],
  "contributes": {
    "pages": [{ "id": "example.drafts.workbench", "slot": "example.drafts.page",
      "path": "extensions/example.drafts/workbench", "title": "独立草稿工作台",
      "roles": ["admin", "operator"], "section": "开发者扩展", "order": 10 }]
  }
}
