# Complete nginx.conf, mounted as /etc/motor-console/nginx.conf.
# The entire process runs as UID/GID 101; do not add a root-only user directive.
worker_processes 1;
pid /var/run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 256;
}

http {
    access_log off;
    server_tokens off;
    client_max_body_size 8m;
    client_body_timeout 30s;
    send_timeout 200s;
    keepalive_timeout 65s;

    client_body_temp_path /var/cache/nginx/client_temp;
    proxy_temp_path /var/cache/nginx/proxy_temp;

    upstream motor_console_control {
        server 127.0.0.1:19080;
        keepalive 8;
    }

    server {
        listen 19443 ssl;
        server_name _;

        ssl_certificate /etc/motor-console-tls/server.crt;
        ssl_certificate_key /etc/motor-console-tls/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5:!3DES;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:MotorConsoleTLS:2m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;

        location / {
            proxy_pass http://motor_console_control;
            proxy_http_version 1.1;

            # Retain the public port for exact-origin authentication and redirects.
            proxy_set_header Host $http_host;
            proxy_set_header Origin $http_origin;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port 19443;
            # This is the public edge: discard caller-supplied forwarding chains.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Forwarded "";

            proxy_connect_timeout 5s;
            proxy_read_timeout 200s;
            proxy_send_timeout 200s;
            proxy_next_upstream off;
            proxy_cache off;
            proxy_buffering off;
            proxy_request_buffering on;
            proxy_max_temp_file_size 0;
            proxy_redirect off;

            # Request errors can include the full URI in stock nginx logs.
            # Keep startup/TLS diagnostics above; application request evidence
            # belongs in the console's structured, redacted logs.
            error_log /dev/null crit;
        }
    }
}
