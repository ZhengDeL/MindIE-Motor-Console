# Copy to .env locally. These blank fields are intentionally not credentials.
# Generate each secret independently: python -c "import secrets; print(secrets.token_urlsafe(32))"
MOTOR_CONSOLE_TOKEN=
# Development control setup; production uses prepare_production.py + mounted secrets.
MOTOR_BOOTSTRAP_TOKEN=
MOTOR_COOKIE_SECURE=false
MOTOR_TRUSTED_ORIGINS=http://127.0.0.1:19080
# Optional platform documentation; blank or invalid values hide all documentation links.
MOTOR_DOCUMENTATION_URL=
MOTOR_ALLOW_LEGACY_TOKEN=false
MOTOR_AGENT_TOKEN=
# Set a separate stable secret before storing node credentials; retain it for recovery.
MOTOR_SECRET_KEY=
MOTOR_CONSOLE_IMAGE=motor-console:local
MOTOR_CONTROL_BIND_IP=127.0.0.1
MOTOR_CONTROL_PORT=19080
MOTOR_DEMO_PORT=19000
MOTOR_AGENT_BIND_IP=127.0.0.1
MOTOR_AGENT_PORT=19082
MOTOR_HOST_UPSTREAM_DIR=/opt/motor/upstream
MOTOR_HOST_WORKSPACE_DIR=/opt/motor-console/workspace
INSTALL_KUBECTL=true
KUBECTL_VERSION=v1.34.1
# Optional Kubernetes override; use an absolute host path to a flattened kubeconfig.
MOTOR_KUBECONFIG_FILE=
# Optional CA/key paths must also be mounted into the appropriate container.
MOTOR_AGENT_CA_BUNDLE=
# Control-to-Agent mTLS identity; independent of the native Motor API below.
# Set container paths and mount the files read-only. The Agent TLS gateway must
# separately require/verify client certificates and protect its HTTP backend.
MOTOR_AGENT_CLIENT_CERT_FILE=
MOTOR_AGENT_CLIENT_KEY_FILE=
MOTOR_AGENT_CLIENT_KEY_PASSWORD_FILE=
MOTOR_AGENT_MTLS_REQUIRED=false
# Administrator-only fresh Agent installs use this dedicated path on each target.
MOTOR_AGENT_ROLLOUT_ROOT=/var/lib/motor-console-agents
MOTOR_CA_BUNDLE=
MOTOR_MANAGEMENT_KEY_FILE=
MOTOR_INFERENCE_API_KEY=
# Optional native Motor API mutual TLS client material. Mount files read-only.
MOTOR_CLIENT_CERT_FILE=
MOTOR_CLIENT_KEY_FILE=
MOTOR_CLIENT_KEY_PASSWORD_FILE=
# Client HTTP material is deployment-owned; native JSON paths are never read by the client.
MOTOR_CLIENT_CRL_FILE=
MOTOR_CLIENT_MTLS_REQUIRED=false

# Resource observations are deployment owned. Unknown is never an idle device.
MOTOR_NODE_SAMPLE_SECONDS=15
MOTOR_NODE_SAMPLE_CONCURRENCY=3
MOTOR_NPU_ADMISSION_MODE=observed
MOTOR_RESOURCE_CACHE_SECONDS=10
MOTOR_RESOURCE_TTL_SECONDS=45
# Prefer a local read-only host snapshot, or configure a trusted Ascend NPU Exporter.
MOTOR_NPU_SNAPSHOT_FILE=
MOTOR_NPU_METRICS_URL=
MOTOR_NPU_METRICS_CA_FILE=
MOTOR_NPU_DEVICE_MAP_JSON={}
MOTOR_NPU_PROCESS_PID_SCOPE=unknown
# Optional console composition; restart only the matching platform component.
# Direct Python/uvicorn uses MOTOR_DISABLED_PLUGINS instead.
# Example: grafana,branding; Docker-off also requires images in this list.
MOTOR_CONTROL_DISABLED_PLUGINS=
MOTOR_AGENT_DISABLED_PLUGINS=
MOTOR_DEMO_DISABLED_PLUGINS=
# Native runs accept an absolute directory; Compose expects a container path
# inside a writable dedicated volume. Default: MOTOR_DATA_DIR/plugin-packages.
MOTOR_PLUGIN_DIR=
