{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qinghuan:plugin-manifest:1",
  "title": "MindIE-Motor Console source plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "api_version",
    "entrypoint",
    "license",
    "author",
    "minimum_host_version",
    "access"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9.+() -]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[A-Za-z0-9.-]+)?$",
      "maxLength": 96
    },
    "api_version": {
      "const": 1,
      "type": "integer"
    },
    "entrypoint": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "minimum_host_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "maximum_host_version_exclusive": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "maxLength": 64
      },
      "uniqueItems": true,
      "maxItems": 32,
      "default": []
    },
    "dependency_versions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minimum"
        ],
        "properties": {
          "minimum": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "maxLength": 32
          },
          "maximum_exclusive": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "maxLength": 32
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^/api/plugins/[a-z][a-z0-9-]{0,63}(?:/(?:[A-Za-z0-9_.-]+|\\{[A-Za-z_][A-Za-z0-9_]*\\}))*$"
          },
          "subtree": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "maxItems": 32,
      "default": []
    },
    "access": {
      "type": "string",
      "enum": [
        "viewer",
        "operator",
        "admin"
      ]
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "endpoint",
          "access"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "kind": {
            "const": "status-table"
          },
          "group": {
            "const": "插件",
            "default": "插件"
          },
          "endpoint": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^/api/plugins/[a-z][a-z0-9-]{0,63}(?:/[A-Za-z0-9_.-]+)*$"
          },
          "access": {
            "type": "string",
            "enum": [
              "viewer",
              "operator",
              "admin"
            ]
          }
        }
      },
      "maxItems": 8,
      "default": []
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.:_-]{0,95}$"
      }
    }
  },
  "x-runtime-rules": [
    "IDs must not replace host or bundled plugins",
    "Every route stays in /api/plugins/<manifest.id>",
    "Navigation IDs are unique; endpoints have declared routes and cannot grant weaker access",
    "Version bounds are checked against the host and complete selected dependency graph",
    "Display text must be nonblank and exclude Unicode control, format and line-separator characters"
  ],
  "x-package-limits": {
    "compressed_bytes": 8388608,
    "expanded_bytes": 16777216,
    "member_bytes": 2097152,
    "members": 128,
    "selected_plugins": 32
  }
}
